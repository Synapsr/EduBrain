{
  "name": "edubrain",
  "version": "0.1.0",
  "private": true,
  "description": "Assistant conversationnel IA souverain pour les enseignants, branché sur Albert API (DINUM).",
  "license": "EUPL-1.2",
  "author": "Synapsr <contact@synapsr.io>",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @edubrain/db db:generate",
    "db:migrate": "pnpm --filter @edubrain/db db:migrate",
    "db:seed": "pnpm --filter @edubrain/db db:seed",
    "db:studio": "pnpm --filter @edubrain/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "turbo": "^2.9.16",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
