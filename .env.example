# ==============================================================
#  EduBrain — variables d'environnement (exemple commenté)
#  Démarrage : cp .env.example .env   (à la racine du monorepo)
#  ⚠️  AUCUN secret réel ne doit être committé. `.env` est gitignoré.
#  Les variables serveur sont validées au démarrage (Zod) : l'API
#  échoue tôt et clairement si l'une est manquante ou invalide.
# ==============================================================

# Environnement : development | test | production
NODE_ENV=development

# --- Albert API (IA souveraine — DINUM) -----------------------
# URL de base OpenAI-compatible (confirmée).
ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1

# Clé Albert — LAISSER VIDE pour le MODE DÉMO (provider mock local :
# l'app, le streaming et les tests fonctionnent sans clé réelle).
# Renseignez-la pour utiliser le vrai modèle. Côté serveur uniquement.
ALBERT_API_KEY=

# Identifiants de modèles (à vérifier via GET /v1/models avec une clé).
# Petit modèle par défaut = frugalité.
ALBERT_CHAT_MODEL_SMALL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
ALBERT_CHAT_MODEL_LARGE=openai/gpt-oss-120b
ALBERT_EMBEDDING_MODEL=BAAI/bge-m3

# Transcription audio→texte (dictée dans le chat). Whisper côté Albert.
ALBERT_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Dimension des vecteurs d'embedding (= taille de la colonne pgvector).
# Défaut 1024 (Albert BAAI/bge-m3). Changez cette valeur ET régénérez la
# migration `chunks` (vector(N) est figé à la migration).
ALBERT_EMBEDDING_DIM=1024

# --- Base de données (PostgreSQL + pgvector) ------------------
# `docker compose up -d` démarre une base compatible localement.
DATABASE_URL=postgres://edubrain:edubrain@localhost:5432/edubrain

# --- Réseau / CORS --------------------------------------------
API_PORT=8787
# Origine autorisée par le CORS (le front Next.js en dev).
WEB_ORIGIN=http://localhost:3000

# --- Front (Next.js) ------------------------------------------
# Base de l'API appelée par le navigateur. Préfixe NEXT_PUBLIC_ ⇒ exposé au
# client et inliné au build. Le front utilise http://localhost:8787 par défaut ;
# pour surcharger, définissez-la dans apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8787
